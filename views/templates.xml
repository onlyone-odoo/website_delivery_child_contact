<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cart_inherit" inherit_id="website_sale.cart">
        <xpath expr="//h3[@class='mb-4']" position="after">
            <div>
                <t t-if="child_contacts and child_contacts.filtered(lambda c: c.type == 'contact')">
                    <div class="mb-4">
                        <label class="form-label">Comprando para:</label>
                        <select id="child_select" class="form-select" required="required">
                            <option value="" selected="selected" disabled="disabled">Seleccione un contacto</option>
                            <t t-foreach="child_contacts.filtered(lambda c: c.type == 'contact')" t-as="child">
                                <option t-att-value="child.id"
                                        t-att-selected="website_sale_order.partner_shipping_id.id == child.id">
                                    <t t-esc="child.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                </t>
                <t t-else="">
                    <p>No hay contactos hijos disponibles.</p>
                </t>
            </div>
        </xpath>
    </template>
    <template inherit_id="website_sale.product" id="select_quantity_inherit">
        <!-- Ocultar el selector de cantidades existente -->
        <xpath expr="//div[contains(@class, 'css_quantity')]" position="attributes">
            <attribute name="class">css_quantity d-none</attribute>
        </xpath>
        <!-- Forzar add_qty a 1 en el formulario oculto -->
        <xpath expr="//form[@action='/shop/cart/update']" position="inside">
            <input type="hidden" name="add_qty" value="1"/>
        </xpath>
    </template>
</odoo>